"iris is a ray tracer written in C++23"
module(name = "iris", version = "head")

# Bazel Central Registry dependencies
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
bazel_dep(name = "libdeflate", version = "1.26")
bazel_dep(name = "plyodine", version = "1.1.2")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "openexr", version = "3.5.2")
bazel_dep(name = "pbrt_proto", version = "1.0.0")
bazel_dep(name = "protobuf", version = "37.0-rc1")

# Git Dependencies
bazel_dep(name = "libfbsdf")
git_override(
    module_name = "libfbsdf",
    remote = "https://github.com/bradleymarie/libfbsdf.git",
    commit = "20d487851fd69550700e0d1c3e104042e7e73751",
)

bazel_dep(name = "libspd")
git_override(
    module_name = "libspd",
    remote = "https://github.com/bradleymarie/libspd.git",
